# Database
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/laser_robot
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_password

# Dify / AI
DIFY_API_BASE_URL=http://localhost:8280/v1
DIFY_API_KEY_AI=your_dify_ai_key
DIFY_API_KEY_VIRTUAL=your_dify_virtual_key

# XunFei virtual avatar
XF_AVATAR_APP_ID=your_app_id
XF_AVATAR_API_KEY=your_api_key
XF_AVATAR_API_SECRET=your_api_secret
XF_AVATAR_SCENE_ID=your_scene_id
XF_AVATAR_ID=your_avatar_id
XF_AVATAR_VCN=your_voice_name

# MinIO
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=dental-robot-bucket

# Frontend dev proxy
VITE_PROXY_API_TARGET=http://localhost:8253
VITE_PROXY_MINIO_TARGET=http://localhost:9000

# Optional deploy script variables
DEPLOY_HOST=your_server_host
DEPLOY_PORT=22
DEPLOY_USERNAME=your_ssh_user
DEPLOY_PASSWORD=your_ssh_password
